{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {"api/vault.js": {"maxDuration": 30}},
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; worker-src 'self'; manifest-src 'self'"}
    ]},
    {"source": "/sw.js", "headers": [{"key":"Cache-Control","value":"no-cache"}]},
    {"source": "/api/(.*)", "headers": [{"key":"Cache-Control","value":"no-store, private"}]}
  ]
}
